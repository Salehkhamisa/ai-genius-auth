PORT=5000
NODE_ENV=development

# JWT Configuration
# Change these secrets in production
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Expirations (Access token short-lived, Refresh token long-lived)
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Refresh token cookie expiration in days
JWT_COOKIE_EXPIRE=7

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017/ai_genius_auth

