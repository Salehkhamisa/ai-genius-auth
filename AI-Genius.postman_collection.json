					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/ai/free-model",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"ai",
								"free-model"
							]
						},
						"description": "Tests access to the Free AI Model. This endpoint requires standard authentication (any role: Free_User, Premium_User, Admin)."
					},
					"response": []
				},
				{
					"name": "Query Premium AI Model",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"prompt\": \"Explain how asymmetric cryptography protects network packets.\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/ai/premium-model",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"ai",
								"premium-model"
							]
						},
						"description": "Tests access to the Premium AI Model. Allowed roles: Premium_User and Admin. Free_User will receive a 403 Forbidden response."
					},
					"response": []
				},
				{
					"name": "Delete System Cache (Admin Only)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/ai/purge-cache",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"ai",
								"purge-cache"
							]
						},
						"description": "Tests cache purge command. Accessible only by Admin. Both Free_User and Premium_User will receive 403 Forbidden responses."
					},
					"response": []
				}
			],
			"description": "Testing endpoints designed to enforce Role-Based Access Control limits."
		}
	],
